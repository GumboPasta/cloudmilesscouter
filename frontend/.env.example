# Base URL of the Go REST API (cmd/api). Copy this file to .env.local to override.
# When unset, the client falls back to http://localhost:8080.
VITE_API_BASE_URL=http://localhost:8080

# In production (Vercel), set VITE_API_BASE_URL in the project's Environment
# Variables to a PUBLIC URL for the API — the Go API is local-only until Phase 7,
# so until then that means a tunnel to it (cloudflared / ngrok). Vite inlines
# this value at build time, so changing it needs a redeploy. See frontend/README.md.
